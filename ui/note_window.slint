import { LineEdit, TextEdit, Button } from "std-widgets.slint";

// 笔记记录窗口：上方为保存目录输入框，中间为笔记内容输入框，底部为状态和保存按钮。
//
// 目录与内容的读写、持久化都在 Rust 侧完成，本组件只负责展示和转发事件。
export component NoteWindow inherits Window {
    in-out property <string> save-dir: "";
    in-out property <string> note-content: "";
    in-out property <string> status: "";
    in-out property <bool> status-ok: true;   // true=绿色提示，false=红色警告

    callback save-clicked();
    callback browse-clicked();
    callback dir-accepted(text: string);
    callback close-clicked();

    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 460px;
    height: 400px;
    title: "笔记";

    Rectangle {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        background: #1f2430;
        border-radius: 12px;
        border-width: 1px;
        border-color: #ffffff2a;
        drop-shadow-color: #00000088;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 4px;

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            // 标题栏
            HorizontalLayout {
                height: 28px;
                Text {
                    text: "笔记";
                    color: white;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 13px;
                    background: close-touch.has-hover ? #e81123 : #ffffff18;
                    Text {
                        text: "✕";
                        color: white;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    close-touch := TouchArea {
                        clicked => { root.close-clicked(); }
                    }
                }
            }

            // 保存目录
            HorizontalLayout {
                height: 32px;
                spacing: 8px;
                Text {
                    text: "保存目录";
                    color: #aab0bd;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "未设置（保存前请先填写）";
                    text <=> root.save-dir;
                    accepted(text) => { root.dir-accepted(text); }
                }
                Button {
                    text: "浏览";
                    clicked => { root.browse-clicked(); }
                }
            }

            // 笔记内容
            TextEdit {
                vertical-stretch: 1;
                text <=> root.note-content;
                placeholder-text: "在这里输入笔记内容…";
                font-size: 14px;
            }

            // 状态 + 保存按钮
            HorizontalLayout {
                height: 36px;
                spacing: 8px;
                Text {
                    text: root.status;
                    color: root.status-ok ? #6cc26c : #e06c60;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                Button {
                    text: "保存";
                    primary: true;
                    clicked => { root.save-clicked(); }
                }
            }
        }
    }
}
